# Copy to .env if you want overrides. .env is not committed.
# Existing environment variables win over this file.

OLLAMA_HOST=http://127.0.0.1:11434
NOMO_ROUTE_MODEL=llama3.2:latest
NOMO_REASON_MODEL=llama3.1:8b
NOMO_EMBED_MODEL=nomic-embed-text:latest
NOMO_CODE_MODEL=
NOMO_OPERATOR=
NEEDLE_TELEMETRY=0
DO_NOT_TRACK=1

# Set to 1 only in the process that should run `python nomo.py run`.
# NOMO_ALLOW_RUN=1
